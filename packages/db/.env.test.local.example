# RLS integration test credentials — local Supabase dev stack only.
# Copy this file to .env.test.local (gitignored) and fill in values
# from `supabase status` run inside packages/db.
#
# TEST_SUPABASE_URL is optional — defaults to http://127.0.0.1:54321
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=<Publishable key from supabase status>
TEST_SUPABASE_SERVICE_KEY=<Secret key from supabase status>
