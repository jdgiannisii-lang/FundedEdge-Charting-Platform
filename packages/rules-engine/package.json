  },
  "devDependencies": {
    "@fundededge/config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.22.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  }
