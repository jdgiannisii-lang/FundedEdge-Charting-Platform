# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — secret (server-only, NEVER commit real values)
# Used by createServiceClient() which bypasses RLS. Keep out of client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Resend — transactional email
RESEND_API_KEY=re_your_resend_api_key

# Sentry — error monitoring (public DSN, safe to expose)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX

# PostHog — product analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key

# App URL — used for OAuth callback construction
NEXT_PUBLIC_SITE_URL=http://localhost:3000
